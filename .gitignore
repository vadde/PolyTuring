# ============================================================================
# POLYTURING — Global .gitignore
# Enterprise-grade polyglot ignore patterns
# ============================================================================

# ─── OS Generated ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
_site/
.playwright-mcp/

# ─── IDE / Editors ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
!tools/session-explorer/src/web/dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
ENV/
env/
.env
.env.local
.env.*.local
*.pyc
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pytype/

# ─── Node.js / JavaScript / TypeScript ──────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.eslintcache
.parcel-cache
.next/
.nuxt/
out/

# ─── Go ─────────────────────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out
vendor/
go.work

# ─── Rust ────────────────────────────────────────────────────────────────────
target/
Cargo.lock
**/*.rs.bk

# ─── Build Artifacts ────────────────────────────────────────────────────────
bin/
*.o
*.a
*.lib
*.log
*.tmp
*.temp
*.bak
*.backup

# ─── Secrets & Credentials ──────────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12
*.pfx
.secret
secrets/
credentials/
*.credentials
service-account*.json

# ─── Data & Notebooks ───────────────────────────────────────────────────────
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
.ipynb_checkpoints/
*.sqlite
*.db

# ─── Docker ──────────────────────────────────────────────────────────────────
.docker/

# ─── Terraform ───────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
